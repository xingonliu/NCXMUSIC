{
  "name": "ncxmusic",
  "version": "0.0.1",
  "private": true,
  "description": "NcxMusic desktop client",
  "author": "NcxMusic Contributors",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\" && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "build": "electron-vite build && node scripts/verify-build.mjs",
    "package": "electron-vite build && node scripts/verify-build.mjs && electron-builder --publish never",
    "package:dir": "electron-vite build && node scripts/verify-build.mjs && electron-builder --dir --publish never",
    "smoke:dev": "node scripts/run-electron-smoke.mjs development",
    "smoke:build": "electron-vite build && node scripts/verify-build.mjs && node scripts/run-electron-smoke.mjs build",
    "smoke:packaged": "electron-vite build && node scripts/verify-build.mjs && electron-builder --dir --publish never && node scripts/run-electron-smoke.mjs packaged",
    "release": "electron-vite build && node scripts/verify-build.mjs && electron-builder --publish always"
  },
  "dependencies": {
    "vue": "3.5.41",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "build": {
    "appId": "io.github.ncxmusic.app",
    "productName": "NcxMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "out/main/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    }
  }
}
