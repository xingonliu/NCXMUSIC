{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/utility/**/*.ts",
    "src/input-hook/**/*.ts",
    "src/local-asr/**/*.ts",
    "src/domains/**/*.ts",
    "src/shared/**/*.ts",
    "src/infrastructure/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/unit/player-bar.test.ts",
    "tests/unit/player-keyboard-shortcuts.test.ts",
    "tests/unit/immersive-player.test.ts",
    "tests/unit/fluid-mesh-background.test.ts",
    "tests/unit/music-progress-bar.test.ts",
    "tests/unit/design-system-lab-page.test.ts",
    "tests/unit/phase4-music-ui.test.ts",
    "tests/unit/secondary-music-page-ui.test.ts",
    "tests/unit/agent-markdown.test.ts"
  ]
}
