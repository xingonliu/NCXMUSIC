{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/utility/**/*.ts",
    "src/input-hook/**/*.ts",
    "src/domains/**/*.ts",
    "src/shared/**/*.ts",
    "src/infrastructure/**/*.ts",
    "tests/**/*.ts"
  ]
}
