# NcxMusic 环境变量示例
#
# 本文件可提交 Git；实际值放入对应的 .env.local / .env 文件中。
# 所有 .env 文件已被 .gitignore 排除。

# ── T-02 登录 Session Spike ──

# 测试场景：guest / invalid / expired / interactive / restore / logout / switch
NCX_T02_SCENARIO=

# ── T-03 播放媒体链路 Spike ──

# 激活 T-03 Spike 模式（写入凭据 env、启动 webRequest 观测、运行媒体 Smoke）
# 仅供 T-03 验证，生产代码不读取此变量。
NCX_T03_SPIKE=

# 待验证的曲目 ID，逗号分隔
NCX_T03_TRACKS=

# 从持久 Session 提取的网易云 Cookie 头（自动写入，无需手动填写）
NCX_T03_COOKIE_HEADER=

# 从 Cookie 头提取的 MUSIC_U 值（自动写入，无需手动填写）
NCX_T03_MUSIC_U=

# 账户标识（自动写入，无需手动填写）
NCX_T03_ACCOUNT_ID=
